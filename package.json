{
  "name": "least-count-workspace",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "shared",
    "worker",
    "frontend"
  ],
  "scripts": {
    "dev": "concurrently -n \"worker,frontend\" -c \"blue,green\" \"npm run dev -w worker\" \"npm run dev -w frontend\"",
    "test": "npm run test -w shared",
    "build": "npm run build -w shared && npm run build -w frontend",
    "deploy": "wrangler deploy",
    "deploy:worker": "npm run deploy -w worker",
    "deploy:frontend": "npm run deploy -w frontend"
  },
  "devDependencies": {
    "concurrently": "^9.1.2",
    "wrangler": "^3.109.2"
  }
}

